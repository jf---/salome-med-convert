#!/usr/bin/env python
# coding=utf-8

"""Main start-up point of *Mac3Coeur* plugin's standalone application."""

from __future__ import unicode_literals

import os
import os.path as osp
import sys
import signal

from PyQt5 import Qt as Q
from convmail.gui.gui import load_language, MainWindow
from convmail.gui.settings import Settings

import salome_instance

#Tell SIGINT to perform its default function.
signal.signal(signal.SIGINT, signal.SIG_DFL)

def main():
    """Main function."""
    
    # create application
    app = Q.QApplication(sys.argv)
    app.lastWindowClosed.connect(app.quit)
    
    lang = 'en'
    if 'fr' in Q.QLocale.system().name():
        lang = 'fr'


    # settings = Settings()      
        
    translator = load_language(lang)
    main_window = MainWindow()
    translator.setParent(main_window)
  #  main_window.from_settings(settings)
    main_window.exec_()
    
if __name__ == "__main__":
    sys.exit(main())
