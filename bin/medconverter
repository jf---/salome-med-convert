#!/usr/bin/env python
# coding=utf-8

"""Main start-up point of *medconverter* plugin's standalone application."""

import argparse
import sys
import signal

from medconverter import Fmt, convert as convert_engine, start

# Tell SIGINT to perform its default function.
signal.signal(signal.SIGINT, signal.SIG_DFL)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        usage=__doc__,
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser.add_argument('-v', '--verbose', action='store_true',
                        help="print more informations")
    parser.add_argument('-i', '--input', action='store', dest='input',
                        help="Filename of the mesh to be converted")
    parser.add_argument('-o', '--output', action='store', dest='output',
                        help="Path to write the MED file to")
    parser.add_argument('-fi', '--input-format', action='store', dest='finput',
                        help="Input format")
    parser.add_argument('-fo', '--output-format', action='store', dest='foutput',
                        help="Output format")
    parser.add_argument('-co', '--output-command', action='store', dest='output_comm',
                        help="Path to write the COMM file to", default=None)
    

    args = parser.parse_args()
    if not (args.input or args.output) :
        start()
    else :
       
        if not args.input:
            parser.error("Missing input filename: use '--input'")
        if not args.output:
            parser.error("Missing output filename: use '--output'")

        if args.finput and not args.foutput :
            parser.error("Missing output format: use '--output-format'")
        if args.foutput and not args.finput :
            parser.error("Missing input format: use '--input-format'")

        convert_engine(args.input, Fmt.get(args.finput), args.output, Fmt.get(args.foutput), args.output_comm, verbose=args.verbose)

    sys.exit(0)
