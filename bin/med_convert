#!/usr/bin/env python
# coding=utf-8

"""Main start-up point of *MedConvert* plugin's standalone application."""

import sys
import signal

from med_convert.gui.gui import start

# Tell SIGINT to perform its default function.
signal.signal(signal.SIGINT, signal.SIG_DFL)

def main():
    """Main function."""
    start()
    return 0

if __name__ == "__main__":
    sys.exit(main())
